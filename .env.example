# API-Football (rotacao de 3 keys)
API_FOOTBALL_KEY1=
API_FOOTBALL_KEY2=
API_FOOTBALL_KEY3=

# The-Odds-API (18+ bookmakers)
THE_ODDS_API_KEY=

# Odds-API.io (6 keys com rotation)
ODDS_KEY1=
ODDS_KEY2=
ODDS_KEY3=
ODDS_KEY4=
ODDS_KEY5=
ODDS_API_KEY=

# Provider LLM (OpenAI-compatible: OpenRouter, Groq, etc)
# Groq:  https://api.groq.com/openai/v1  |  llama-3.3-70b-versatile
# OpenRouter: https://openrouter.ai/api/v1  |  anthropic/claude-sonnet-4
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_MODEL=llama-3.3-70b-versatile

# Claude API (fallback se OPENROUTER_API_KEY nao configurado)
ANTHROPIC_API_KEY=

# OpenAI (para embeddings do RAG)
OPENAI_API_KEY=

# Telegram (alertas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Caminhos
FOOTBALL_AI_HOME=/home/palpites/football_ai
ANALISTA_V1_DB=/home/palpites/analista/dados/analista.db
FOOTBALL_DATA_DB=/home/palpites/analista/dados/football_data.db

# Logs
LOG_LEVEL=INFO
